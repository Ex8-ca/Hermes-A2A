# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Editor
.idea/
.vscode/
*.swp
.DS_Store

# Repo-local: a downloaded copy of the bundled A2A plugin, kept here so
# tests can run without depending on the user's live HERMES_HOME. NOT
# shipped in the wheel.
local_only/

# Virtualenv
.venv/
venv/

# Wrangler (Cloudflare Workers dev tooling) — local cache + generated
# config, both safe to ignore. Used by the directory/ Worker scaffold
# (see directory/worker/README.md) and any other Wrangler-managed code
# in the repo.
.wrangler/
wrangler.jsonc
wrangler.toml.bak

# Operator-local state files (mode 0600, contain private keys
# and audit history; never share these).
directory/operator/.deletion-audit.log
directory/operator/.tailscale-cache.json
directory/operator/*.key
directory/operator/*.pem

# uv's lockfile for the plugin's CLI; we don't track it.
uv.lock